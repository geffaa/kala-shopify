# Store
SHOPIFY_SHOP=kala-dev.myshopify.com
SHOPIFY_API_VERSION=2026-07
STOREFRONT_URL=https://kala-dev.myshopify.com

# Auth — either a static Admin token…
SHOPIFY_ADMIN_TOKEN=
# …or a Dev Dashboard app in the same org (client credentials grant).
# The client secret is also used to verify webhooks and app proxy requests.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

PORT=8787
LOW_STOCK_THRESHOLD=3

# Optional integrations — when empty, messages are logged instead.
SLACK_WEBHOOK_URL=
FULFILLMENT_WEBHOOK_URL=
FULFILLMENT_SIGNING_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Kala <drops@example.com>"

# Optional: raises PageSpeed Insights quota
PSI_API_KEY=
