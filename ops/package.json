{
  "name": "kala-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Webhooks, app proxy and store-health tooling for the Kala Shopify store",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "doctor": "node src/cli.js audit",
    "launch-check": "node src/cli.js launch-check",
    "seed": "node src/cli.js seed",
    "webhooks:list": "node src/cli.js webhooks"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  }
}
